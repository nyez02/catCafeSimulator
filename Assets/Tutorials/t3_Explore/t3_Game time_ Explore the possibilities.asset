--- !u!114 &2879849042596939525
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: INSTRUCTIONS
  Text:
    m_Untranslated: '<b>1</b>.  In the <b>Project</b> window, open the <b>Assets</b> > <b>Prefabs</b> folder.


      <b>2</b>.  Drag the Moving_Platform prefab into the scene and position it at the edge of the <b>Ground</b> GameObject.


      <b>Note</b>: It doesn''t matter if the platform intersects with the <b>Ground</b> GameObejct.


      <b>3</b>.  Enter Play mode and use the platform to collect the star. '
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
